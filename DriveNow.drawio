        <mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.1;endArrow=classic;endFill=1;startArrow=none;" parent="1" edge="1" source="5" target="22">
          <mxGeometry x="0" y="0" width="0" height="0" as="geometry" />
        </mxCell>
        <mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.2;endArrow=classic;endFill=1;startArrow=none;" parent="1" edge="1" source="15" target="10">
          <mxGeometry x="0" y="0" width="0" height="0" as="geometry" />
        </mxCell>
        <mxCell id="25" value="PART.PartNo" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=7;fontColor=#334155;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1810.0" y="831" width="126" height="30" as="geometry" />
        </mxCell>
        <mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.1;endArrow=classic;endFill=1;startArrow=none;" parent="1" edge="1" source="16" target="25">
          <mxGeometry x="0" y="0" width="0" height="0" as="geometry" />
