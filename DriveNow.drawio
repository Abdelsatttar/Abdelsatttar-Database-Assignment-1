        <mxCell id="12" value="Phone&#xa;NN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;fontSize=10;align=center;verticalAlign=middle;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="1952.0" y="407" width="150" height="68" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Email&#xa;NN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;fontSize=10;align=center;verticalAlign=middle;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="2106.0" y="407" width="150" height="68" as="geometry" />
        </mxCell>
        <mxCell id="14" value="SUPPLIER_PART" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1F4E79;" parent="1" vertex="1">
          <mxGeometry x="1644.0" y="660" width="612" height="24" as="geometry" />
        </mxCell>
        <mxCell id="15" value="SupplierID&#xa;NN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10;fontStyle=4;align=center;verticalAlign=middle;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="1644.0" y="687" width="150" height="68" as="geometry" />
        </mxCell>
        <mxCell id="16" value="PartNo&#xa;NN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10;fontStyle=4;align=center;verticalAlign=middle;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="1798.0" y="687" width="150" height="68" as="geometry" />
        </mxCell>
        <mxCell id="17" value="SupplierPrice&#xa;NN  CK:&gt;=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;fontSize=10;align=center;verticalAlign=middle;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="1952.0" y="687" width="150" height="68" as="geometry" />
        </mxCell>
        <mxCell id="18" value="DeliveryLeadTimeDays&#xa;NN  CK:&gt;=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;fontSize=10;align=center;verticalAlign=middle;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="2106.0" y="687" width="150" height="68" as="geometry" />
        </mxCell>
        <mxCell id="19" value="PK(SupplierID, PartNo)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#7C2D12;" parent="1" vertex="1">
          <mxGeometry x="1644.0" y="757" width="612" height="42" as="geometry" />
        </mxCell>
        <mxCell id="20" value="JOB_CARD.JobNo" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=7;fontColor=#334155;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1656.0" y="271" width="126" height="30" as="geometry" />
        </mxCell>
        <mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.1;endArrow=classic;endFill=1;startArrow=none;" parent="1" edge="1" source="4" target="20">
          <mxGeometry x="0" y="0" width="0" height="0" as="geometry" />
