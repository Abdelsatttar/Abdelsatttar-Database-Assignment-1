  </diagram>
  <diagram id="text1" name="3-Questions-Assumptions">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="2756" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="DRIVENOW — QUESTIONS, ASSUMPTIONS &amp; CONTRADICTIONS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#17365D;" parent="1" vertex="1">
          <mxGeometry x="35" y="18" width="3530" height="45" as="geometry" />
        </mxCell>
        <mxCell id="3" value="QUESTIONS — clarify with the BA team" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F4E79;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="95" width="1153.3333333333333" height="65" as="geometry" />
        </mxCell>
        <mxCell id="4" value="1. §7.1: Are branch phone numbers mandatory for every branch, or can a branch have none? The SRS says branches keep phone numbers and most have more than one." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="173" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="5" value="2. §7.1: Can a manager assignment have overlapping effective dates? Is the regional director stored as an employee and assigned temporarily?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="312" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="6" value="3. §7.3: What is the exact uniqueness rule for a car model (manufacturer + model + year), and can model year be in the future?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="451" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="7" value="4. §7.3 / §8: Are vehicle-specific prices effective-dated like category rates, and can a vehicle have both category and individual rates?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="590" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="8" value="5. §7.5: Can a GPS device be moved between vehicles? Is installation history required, or only the current installation?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="729" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="9" value="6. §7.7: What attribute distinguishes Egyptian national ID from foreign passport, and are both identifiers globally unique?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="868" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="10" value="7. §7.7 / §8: How should a corporate authorized driver be matched to an individual CUSTOMER record when the same person rents personally? No shared identifier is specified." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="1007" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="11" value="8. §7.7 / §8: Can a corporate authorized driver be an additional driver on a rental, and must every additional corporate driver be on that company’s authorized list?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="1171" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="12" value="9. §7.9: Does a promo use count when a reservation is created, confirmed, or completed? Are cancelled/no-show reservations counted?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="1335" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="13" value="10. §7.10: Can points be redeemed for a discount without a related rental? What happens if a rental is reversed/refunded?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="1474" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="14" value="11. §7.12: Can an extension use a different vehicle, customer, or pickup/return branch from the previous rental?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="1613" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="15" value="12. §7.15: Can a job card be opened from more than one damage report, or can a damage report create more than one job? The SRS says one report leads to one job at most." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="1752" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="16" value="13. §7.16: Are corporate payments recorded against monthly invoices only, while individual payments are linked to rentals? What values are allowed for PaymentType?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="1916" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="17" value="14. §7.16: Can one payment settle multiple invoices, or can one invoice be paid by multiple payments?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="35.0" y="2055" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="18" value="ASSUMPTIONS — used to complete the design" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F4E79;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="95" width="1153.3333333333333" height="65" as="geometry" />
        </mxCell>
        <mxCell id="19" value="1. §7.1: BRANCH_MANAGER_ASSIGNMENT stores manager history with StartDate and nullable EndDate; only one active manager may exist per branch and one employee may manage only one branch at a time." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="173" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="20" value="2. §7.1: Branch and employee IDs are generated by the company; branch code, employee ID, national ID and company email are unique identifiers as appropriate." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="337" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="21" value="3. §7.3: VEHICLE.CurrentBranchCode is the current physical location; it starts equal to HomeBranchCode and is updated by each completed transfer." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="476" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="22" value="4. §7.3: Category rates and individual vehicle rates use non-overlapping effective periods. A vehicle-specific rate overrides its category rate for that vehicle and period." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="615" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="23" value="5. §7.5: A device has at most one current vehicle installation; a NULL VIN and NULL InstallationDate mean the device is in the warehouse. Installation history is not stored in Phase 1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="779" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="24" value="6. §7.7: IndividualCustomer has exactly one of NationalID or PassportNo; the corresponding identifier is unique. Corporate and individual subtypes are total and disjoint." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="943" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="25" value="7. §7.7: Corporate authorized drivers use (CorporateCustomerNo, DriverNo) as their identifier because DriverNo is assigned internally by each company." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="1107" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="26" value="8. §7.8: Each corporate/category discount is represented by an effective-dated row; rows for the same corporate customer and category must not overlap." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="1246" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="27" value="9. §7.10: Loyalty balance is SUM(Earned points) − SUM(Redeemed points); tier is derived: Silver &lt; 1,000, Gold 1,000–4,999, Platinum ≥ 5,000." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="1385" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="28" value="10. §7.11–7.12: A reservation is linked to zero or one rental; a rental may have no reservation (walk-in). ReservationNo on RENTAL is nullable and unique." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="1524" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="29" value="11. §7.12: ReceivingAgentID, ActualReturnDateTime, return odometer and return fuel are NULL until the vehicle is returned." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="1663" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="30" value="12. §7.12: CorporateCustomerNo and MainDriverNo are populated only for corporate rentals; the main driver must be authorized by that same corporate account." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="1802" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="31" value="13. §7.16: PAYMENT references exactly one of RENTAL or CORPORATE_INVOICE. An invoice can contain many rentals, and a rental is billed in at most one corporate invoice." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="1941" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="32" value="14. §7.12 / §7.4: DriverSeqNo identifies an additional driver within one rental; it is generated per rental because the SRS does not supply a driver identifier." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="2105" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
        <mxCell id="33" value="15. §7.15 / §7.16: SupplierID, DiscountID, rate IDs and other missing surrogate identifiers are generated by the system because the SRS gives no natural identifier for them. A corporate invoice is unique per corporate customer and billing period." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="2244" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="34" value="16. General: Email, phone, amount and rate data types use suitable SQL types; all monetary amounts are EGP. Monetary precision/scale is to be confirmed during implementation. Positive/non-negative checks on salaries, rates, prices, costs, fees, credit limits and quantities are design assumptions unless the SRS states the limit explicitly." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="2408" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="35" value="17. §7.9: Promotion DiscountPercent is limited to 0–100% because the SRS gives no explicit upper bound. TaxRegistrationNo and employee CompanyEmail are treated as unique identifiers; this should be confirmed with the BA team." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1223.3333333333333" y="2572" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="36" value="CONTRADICTIONS / AMBIGUITIES FOUND" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F4E79;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2411.6666666666665" y="95" width="1153.3333333333333" height="65" as="geometry" />
        </mxCell>
        <mxCell id="37" value="1. §7.16 vs §7.16 Finance note: the process says a rental may have several payments, while the Finance note says corporate clients are invoiced monthly rather than paying per rental. This is an ambiguity, not a direct contradiction; the design supports rental payments and invoice payments." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2411.6666666666665" y="173" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="38" value="2. §7.5 vs §7.3: every installed GPS device belongs to one vehicle, but some devices remain in the warehouse and not all vehicles have trackers. Modelled as optional 1:1 installation; confirm whether devices may be reassigned and whether history is required." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2411.6666666666665" y="337" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="39" value="3. §7.1: every branch always has a manager, while the regional director may temporarily replace a resigning manager. The design assumes the regional director is an Employee with a dated manager assignment." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2411.6666666666665" y="501" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="40" value="4. §7.7 / §8: corporate drivers may also be individual customers, so a driver identity cannot be globally treated as exclusively corporate. The authorized-driver record remains company-scoped, separate from CUSTOMER; a stable matching method is not specified." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2411.6666666666665" y="665" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="41" value="5. §7.3 / §8: vehicle home branch and current physical branch are different concepts because transfers occur. Both are stored; transfer processing must keep current location consistent with transfer history." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2411.6666666666665" y="829" width="1153.3333333333333" height="155" as="geometry" />
        </mxCell>
        <mxCell id="42" value="6. No other direct statement-to-statement contradiction was identified in the supplied SRS." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2411.6666666666665" y="993" width="1153.3333333333333" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="rules1" name="4-Business-Rules">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="3160" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="DRIVENOW — BUSINESS RULES BEYOND DATABASE CONSTRAINTS" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#17365D;" parent="1" vertex="1">
          <mxGeometry x="30" y="15" width="3540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="3" value="SRS section" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F4E79;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="90" width="430" height="50" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Business rule" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F4E79;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="460" y="90" width="1050" height="50" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Why constraints are not enough" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F4E79;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1510" y="90" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="6" value="How to enforce it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F4E79;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2410" y="90" width="1050" height="50" as="geometry" />
        </mxCell>
        <mxCell id="7" value="§7.1 — Manager history" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="30" y="140" width="430" height="310" as="geometry" />
        </mxCell>
        <mxCell id="8" value="A branch must have exactly one active branch manager, and an employee may manage only one branch at a time. Assignment date ranges for the same branch/employee must not overlap." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="460" y="140" width="1050" height="310" as="geometry" />
        </mxCell>
        <mxCell id="9" value="PK/FK/UNIQUE/CHECK cannot compare date ranges across multiple assignment rows or guarantee exactly one active row over time." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1510" y="140" width="900" height="310" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Use a transactional stored procedure or trigger when inserting/updating BRANCH_MANAGER_ASSIGNMENT. Lock the branch/employee rows, reject overlapping periods, close the prior assignment and ensure one active assignment per branch." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="2410" y="140" width="1050" height="310" as="geometry" />
        </mxCell>
        <mxCell id="11" value="§7.7 — Blacklist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="30" y="450" width="430" height="285" as="geometry" />
        </mxCell>
        <mxCell id="12" value="A blacklisted customer cannot create a new reservation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="460" y="450" width="1050" height="285" as="geometry" />
        </mxCell>
        <mxCell id="13" value="The rule depends on a row in BLACKLIST_RECORD and a separate insert into RESERVATION; a single-row CHECK cannot inspect another table." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1510" y="450" width="900" height="285" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Use a trigger on RESERVATION or, preferably, a booking stored procedure that checks the customer’s active blacklist record before insert/confirmation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="2410" y="450" width="1050" height="285" as="geometry" />
        </mxCell>
        <mxCell id="15" value="§7.9 — Promotion limits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="30" y="735" width="430" height="310" as="geometry" />
        </mxCell>
        <mxCell id="16" value="A promo code may be used only within its validity period and no more than MaxUses times." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="460" y="735" width="1050" height="310" as="geometry" />
        </mxCell>
        <mxCell id="17" value="The validity and usage count require checking PROMOTION dates and counting other RESERVATION rows; aggregate/cross-table logic is beyond a simple CHECK." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1510" y="735" width="900" height="310" as="geometry" />
        </mxCell>
        <mxCell id="18" value="Use a reservation stored procedure/trigger with transaction isolation and locking on the PROMOTION row; validate dates and atomically enforce COUNT(uses) &lt; MaxUses." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="2410" y="735" width="1050" height="310" as="geometry" />
        </mxCell>
        <mxCell id="19" value="§7.10 — Loyalty redemption" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="30" y="1045" width="430" height="310" as="geometry" />
        </mxCell>
        <mxCell id="20" value="A customer cannot redeem more points than the available loyalty balance; the balance and tier must remain consistent with the movement ledger." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="460" y="1045" width="1050" height="310" as="geometry" />
        </mxCell>
        <mxCell id="21" value="The available balance is an aggregate across many LOYALTY_MOVEMENT rows and can change concurrently." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1510" y="1045" width="900" height="310" as="geometry" />
        </mxCell>
        <mxCell id="22" value="Insert movements only through a stored procedure that locks the individual customer/account, calculates earned minus redeemed points, rejects excess redemption, then writes the movement." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="2410" y="1045" width="1050" height="310" as="geometry" />
        </mxCell>
        <mxCell id="23" value="§7.3 / §7.6 — Vehicle location" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="30" y="1355" width="430" height="285" as="geometry" />
        </mxCell>
        <mxCell id="24" value="A transfer must originate from the vehicle’s current branch; after transfer, CurrentBranchCode must equal the destination and the transfer odometer must not be lower than the latest odometer." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="460" y="1355" width="1050" height="285" as="geometry" />
        </mxCell>
        <mxCell id="25" value="This compares VEHICLE with the latest VEHICLE_TRANSFER and changes several rows atomically." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1510" y="1355" width="900" height="285" as="geometry" />
        </mxCell>
        <mxCell id="26" value="Use a transfer stored procedure in one transaction: lock the vehicle, validate FromBranchCode = CurrentBranchCode and odometer, insert VEHICLE_TRANSFER, then update VEHICLE.CurrentBranchCode and CurrentOdometer." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="2410" y="1355" width="1050" height="285" as="geometry" />
        </mxCell>
        <mxCell id="27" value="§7.3 — Status audit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="30" y="1640" width="430" height="285" as="geometry" />
        </mxCell>
        <mxCell id="28" value="Every current vehicle status must correspond to the latest status history entry, and a vehicle under maintenance or retired cannot be assigned to a new rental." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="460" y="1640" width="1050" height="285" as="geometry" />
        </mxCell>
        <mxCell id="29" value="The rule requires cross-table checks against history and the rental insert; it is not enforceable by a single-row CHECK." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1510" y="1640" width="900" height="285" as="geometry" />
        </mxCell>
        <mxCell id="30" value="Use stored procedures/triggers for status changes and rental creation; each status change inserts VEHICLE_STATUS_HISTORY and updates VEHICLE.Status in the same transaction." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="2410" y="1640" width="1050" height="285" as="geometry" />
        </mxCell>
        <mxCell id="31" value="§7.12 — Reservation conversion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="30" y="1925" width="430" height="310" as="geometry" />
        </mxCell>
        <mxCell id="32" value="A rental created from a reservation must match its customer, requested category, pickup/return branches and requested dates; the reservation can be converted only once." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="460" y="1925" width="1050" height="310" as="geometry" />
        </mxCell>
        <mxCell id="33" value="The validation compares several rows/tables and the assigned vehicle’s model/category. UNIQUE prevents duplicate conversion but cannot verify all matching values." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1510" y="1925" width="900" height="310" as="geometry" />
        </mxCell>
        <mxCell id="34" value="Create rentals through a stored procedure that locks the reservation, validates status and all matching values, checks vehicle category, then inserts the rental and updates reservation status atomically." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="2410" y="1925" width="1050" height="310" as="geometry" />
        </mxCell>
        <mxCell id="35" value="§7.15 — Damage repair job" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="30" y="2235" width="430" height="285" as="geometry" />
        </mxCell>
        <mxCell id="36" value="The vehicle on a job card linked to a damage report must be the same vehicle used on the report’s rental." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="460" y="2235" width="1050" height="285" as="geometry" />
        </mxCell>
        <mxCell id="37" value="The vehicle VIN is found through JOB_CARD → DAMAGE_REPORT → RENTAL and cannot be compared by a simple CHECK on one table." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1510" y="2235" width="900" height="285" as="geometry" />
        </mxCell>
        <mxCell id="38" value="Use a trigger or job-card stored procedure to validate the VIN across the related rows before saving the damage-linked job." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="2410" y="2235" width="1050" height="285" as="geometry" />
        </mxCell>
        <mxCell id="39" value="§7.1 — Employee subtypes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="30" y="2520" width="430" height="285" as="geometry" />
        </mxCell>
        <mxCell id="40" value="An employee cannot be both a RENTAL_AGENT and a MECHANIC." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="460" y="2520" width="1050" height="285" as="geometry" />
        </mxCell>
        <mxCell id="41" value="The employee is stored in two subtype tables; a PK/FK in either table does not prevent the same EmployeeID from appearing in both." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1510" y="2520" width="900" height="285" as="geometry" />
        </mxCell>
        <mxCell id="42" value="Use a trigger or controlled staff-role procedure to reject a subtype insert when the EmployeeID exists in the other subtype table." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="2410" y="2520" width="1050" height="285" as="geometry" />
        </mxCell>
        <mxCell id="43" value="§7.1 / §7.7 — Phone numbers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="30" y="2805" width="430" height="285" as="geometry" />
        </mxCell>
        <mxCell id="44" value="Every branch and every customer must have at least one phone number." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="460" y="2805" width="1050" height="285" as="geometry" />
        </mxCell>
        <mxCell id="45" value="The phone numbers are stored in separate multivalued-attribute tables; ordinary row constraints cannot guarantee at least one child row for each parent." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1510" y="2805" width="900" height="285" as="geometry" />
        </mxCell>
        <mxCell id="46" value="Use a transaction-safe application workflow or deferred validation trigger when creating/updating a BRANCH or CUSTOMER, and prevent deleting the last associated phone number." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;align=left;verticalAlign=top;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="2410" y="2805" width="1050" height="285" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
