        <mxCell id="22" value="PART.PartNo" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=7;fontColor=#334155;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1810.0" y="271" width="126" height="30" as="geometry" />
