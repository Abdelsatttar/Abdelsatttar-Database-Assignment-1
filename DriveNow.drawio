        <mxCell id="27" value="Reference boxes are PK endpoints on other schema pages. Composite keys are listed in the table note and every constituent PK column is underlined." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#475569;" parent="1" vertex="1">
