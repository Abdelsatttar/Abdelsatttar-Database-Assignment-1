        <mxCell id="10" value="SupplierID&#xa;NN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10;fontStyle=4;align=center;verticalAlign=middle;spacing=2;" parent="1" vertex="1">
